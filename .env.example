# ========================================================
# VARIÁVEIS DE AMBIENTE DA APLICAÇÃO (NODE.JS)
# ========================================================

# GEMINI_API_KEY: Chave da API do Google Gemini para recursos de IA (opcional)
GEMINI_API_KEY=

# PORT: Porta em que o servidor Node.js irá rodar (Padrão: 3000)
PORT=3000

# NODE_ENV: Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# APP_URL: URL pública do seu site (Ex: https://seudominio.com.br)
APP_URL=


