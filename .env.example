# ========================================================
# VARIÁVEIS DE AMBIENTE DA APLICAÇÃO (NODE.JS)
# ========================================================

# GEMINI_API_KEY: Chave da API do Google Gemini para recursos de IA (opcional)
GEMINI_API_KEY=

# SUPABASE & VERCEL POSTGRES DATABASE CREDENTIALS
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ADMIN & NOTIFICATION CREDENTIALS
ADMIN_EMAIL=
VITE_ADMIN_EMAIL=

# PORT: Porta em que o servidor Node.js irá rodar (Padrão: 3000)
PORT=3000

# NODE_ENV: Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# APP_URL: URL pública do seu site (Ex: https://seudominio.com.br)
APP_URL=


